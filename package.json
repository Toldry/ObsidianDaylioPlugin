{
	"name": "daylio-mood-graph",
	"version": "1.1.12",
	"description": "Visualizes Daylio mood data as a color-coded graph with clickable vault event labels.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"install:test-vault": "node \"scripts/install_test_vault.cjs\"",
		"update:test-vault": "npm run build && npm run install:test-vault",
		"install:custom-vault": "node \"scripts/install_custom_vault.cjs\"",
		"update:custom-vault": "npm run build && npm run install:custom-vault",
		"lint": "eslint src/ --ext .ts",
		"preversion": "npm ls && npm run lint && npm test",
		"version": "node scripts/version_sync.cjs && git add manifest.json",
		"postversion": "git push && git push --tags",
		"release:demo-vault": "node scripts/release_demo_vault.cjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "^4.1.2",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "^1.7.2",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.2"
	}
}
