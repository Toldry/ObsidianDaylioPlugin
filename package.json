{
	"name": "daylio-mood-graph",
	"version": "1.0.0",
	"description": "Visualizes Daylio mood data as a color-coded graph with clickable vault event labels.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"install:vault": "node -e \"const fs=require('fs'),d='daylio_plugin_test_vault/.obsidian/plugins/daylio-mood-graph/';['main.js','main.js.map'].forEach(f=>fs.copyFileSync('build/'+f,d+f));['manifest.json','styles.css'].forEach(f=>fs.copyFileSync(f,d+f))\"",
		"build:vault": "npm run build && npm run install:vault"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^4.1.2",
		"esbuild": "0.25.5",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
