# Path to your personal Obsidian vault (root directory or direct plugin directory)
# Copy this file to .env.local and update with your own path.
# .env.local is ignored by git and will not be committed.

# Example 1: Path to vault root (script will automatically append .obsidian/plugins/daylio-mood-graph)
# OBSIDIAN_VAULT_PATH="C:/Users/YourUsername/Documents/MyObsidianVault"

# Example 2: Exact plugin path
# OBSIDIAN_VAULT_PATH="C:/Users/YourUsername/Documents/MyObsidianVault/.obsidian/plugins/daylio-mood-graph"
